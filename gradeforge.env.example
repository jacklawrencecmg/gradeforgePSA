# Copy this file to "gradeforge.env" (same folder as the start file) and fill it in. Never share or commit gradeforge.env.
GRADEFORGE_PAYWALL=1
# From Stripe Dashboard > Developers > API keys. Use the sk_test_ key while testing, sk_live_ when you are ready.
STRIPE_SECRET_KEY=
# From Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring $6.99/month Price you created in Stripe (price_...). If blank, GradeForge creates the $6.99/month price inline.
STRIPE_PRICE_ID=
# Your public https address, e.g. https://gradeforge.example.com  (used for the links Stripe sends people back to)
GRADEFORGE_BASE_URL=
# Your own login email(s), comma separated. These accounts get the Dataset & Accuracy tabs and are never metered.
GRADEFORGE_ADMIN_EMAILS=
# Set to 1 ONLY when the site is behind your own proxy/host that sets X-Forwarded-For (most hosting platforms). Needed for the per-IP free grade to see real visitor IPs.
GRADEFORGE_TRUST_PROXY=0
# Optional: free grades per IP (default 1) and a fair-use cap of analyses per subscriber per 30 days (0 = no cap).
GRADEFORGE_FREE_GRADES=1
GRADEFORGE_MONTHLY_CAP=0
# Where accounts and analyses are stored. On a host, point this at a persistent disk.
# GRADEFORGE_DATA_DIR=/var/data/gradeforge
