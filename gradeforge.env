# GradeForge Local Testing Configuration
# For real Stripe testing, replace STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET with test-mode keys from https://dashboard.stripe.com

GRADEFORGE_PAYWALL=1

# Stripe Test Keys (get from https://dashboard.stripe.com/apikeys)
# Use sk_test_... keys for testing, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_placeholder_replace_with_real_key

# Stripe Webhook Signing Secret (from Dashboard > Developers > Webhooks)
# Configure webhook endpoint: POST http://localhost:8000/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_real_key

# Optional: a recurring $6.99/month Price from Stripe (price_...)
# If blank, GradeForge creates the price inline
STRIPE_PRICE_ID=

# Base URL for Stripe checkout redirects
# For local testing: http://localhost:8000
# For production: https://yourdomain.com
GRADEFORGE_BASE_URL=http://localhost:8000

# Admin email(s) - comma separated for multiple admins
# These accounts get access to Dataset, Accuracy, Admin tabs and are never metered
GRADEFORGE_ADMIN_EMAILS=futuredaysjel10@gmail.com

# Trust X-Forwarded-For header (1 = yes, only if behind a proxy/host that sets it)
GRADEFORGE_TRUST_PROXY=0

# Free grades per unique IP address (default 1)
GRADEFORGE_FREE_GRADES=1

# Fair-use cap: max analyses per subscriber per 30 days (0 = no cap)
GRADEFORGE_MONTHLY_CAP=0

# Data directory (for local dev, uses ./data by default)
# GRADEFORGE_DATA_DIR=./data
